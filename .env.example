# ---------------------------------------------------------------------------
# Typodocs website — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# `.env*` files are git-ignored; this example file is committed on purpose.
# NEVER commit real secrets. NEVER expose the Supabase service_role key to the
# browser — only the publishable/anon key belongs in VITE_ variables.
# ---------------------------------------------------------------------------

# --- Public website (client, bundled) --------------------------------------
# These are injected into the browser bundle by Vite. Only publishable values.
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-PUBLIC-ANON-KEY"

# --- Server-side only (Vercel environment variables, NOT VITE_ prefixed) ----
# Used only by trusted server-side code / Supabase Edge Functions. Never
# referenced from frontend code. Leave unset in the local static build.
# SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
# SUPABASE_PROJECT_REF="YOUR-PROJECT-ref"

# --- Optional (legacy AI Studio tooling) -----------------------------------
# GEMINI_API_KEY is only used by AI tooling, not by the website runtime.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
